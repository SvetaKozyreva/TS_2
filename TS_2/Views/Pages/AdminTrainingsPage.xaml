<Page x:Class="TS_2.Views.Pages.AdminTrainingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#FFF8F8">

        <StackPanel Margin="25">

            <TextBlock Text="🏋 Керування тренуваннями"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="#6D5555"
                       Margin="0,0,0,20"/>

            <Button x:Name="AddTrainingButton"
                    Content="+ Додати тренування"
                    Width="220"
                    Height="42"
                    HorizontalAlignment="Left"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="AddTraining_Click"/>

            <DataGrid x:Name="TrainingsGrid"
                      Margin="0,25,0,0"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Назва"
                                        Binding="{Binding Name}"/>

                    <DataGridTextColumn Header="Дата"
                                        Binding="{Binding Date}"/>

                    <DataGridTextColumn Header="Час"
                                        Binding="{Binding Time}"/>

                    <DataGridTextColumn Header="Макс. місць"
                                        Binding="{Binding MaxPlaces}"/>

                </DataGrid.Columns>

            </DataGrid>

        </StackPanel>

    </Grid>

</Page>