<Page x:Class="TS_2.Views.Pages.SchedulePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TS_2.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SchedulePage">

    <Grid Background="#FFFDFD">
        <ScrollViewer VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="25">
                <!-- Фільтри -->
                <Grid Margin="0,0,0,25">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0"
              Style="{StaticResource PinkComboBoxStyle}"
              SelectedIndex="0">

                        <ComboBoxItem>Усі напрямки</ComboBoxItem>
                        <ComboBoxItem>Stretching</ComboBoxItem>
                        <ComboBoxItem>Pilates</ComboBoxItem>
                        <ComboBoxItem>Reformer</ComboBoxItem>

                    </ComboBox>

                    <ComboBox Grid.Column="2"
              Style="{StaticResource PinkComboBoxStyle}"
              SelectedIndex="0">

                        <ComboBoxItem>Усі тренери</ComboBoxItem>

                    </ComboBox>

                    <ComboBox Grid.Column="4"
              Style="{StaticResource PinkComboBoxStyle}"
              SelectedIndex="0">

                        <ComboBoxItem>Увесь день</ComboBoxItem>
                        <ComboBoxItem>Ранок</ComboBoxItem>
                        <ComboBoxItem>День</ComboBoxItem>
                        <ComboBoxItem>Вечір</ComboBoxItem>

                    </ComboBox>

                </Grid>

                <!-- Дні тижня -->

                <Grid Margin="0,0,0,20">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="45"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="45"/>
                    </Grid.ColumnDefinitions>

                    <!-- Левая стрелка -->
                    <Button Grid.Column="0"
            Style="{StaticResource ArrowButtonStyle}"
            Content="◀"/>

                    <!-- Дни -->
                    <Border Grid.Column="1"
            Background="#FFE5E5"
            CornerRadius="10"
            Padding="1">
                        <Border.Effect>

                            <DropShadowEffect
            BlurRadius="20"
            ShadowDepth="2"
            Opacity="0.22"
            Color="#E8B4B4"/>

                        </Border.Effect>

                        <UniformGrid Columns="7">

                            <!-- ПН -->
                            <Button Style="{StaticResource ActiveDayButtonStyle}">
                                <StackPanel>
                                    <TextBlock Text="ПН"
                               HorizontalAlignment="Center"
                               FontWeight="SemiBold"/>
                                    <TextBlock Text="14.07"
                               HorizontalAlignment="Center"
                               FontSize="12"/>
                                </StackPanel>
                            </Button>

                            <!-- ВТ -->
                            <Button Style="{StaticResource DayButtonStyle}">
                                <StackPanel>
                                    <TextBlock Text="ВТ"
                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="15.07"
                               HorizontalAlignment="Center"
                               FontSize="12"/>
                                </StackPanel>
                            </Button>

                            <!-- СР -->
                            <Button Style="{StaticResource DayButtonStyle}">
                                <StackPanel>
                                    <TextBlock Text="СР"
                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="16.07"
                               HorizontalAlignment="Center"
                               FontSize="12"/>
                                </StackPanel>
                            </Button>

                            <!-- ЧТ -->
                            <Button Style="{StaticResource DayButtonStyle}">
                                <StackPanel>
                                    <TextBlock Text="ЧТ"
                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="17.07"
                               HorizontalAlignment="Center"
                               FontSize="12"/>
                                </StackPanel>
                            </Button>

                            <!-- ПТ -->
                            <Button Style="{StaticResource DayButtonStyle}">
                                <StackPanel>
                                    <TextBlock Text="ПТ"
                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="18.07"
                               HorizontalAlignment="Center"
                               FontSize="12"/>
                                </StackPanel>
                            </Button>

                            <!-- СБ -->
                            <Button Style="{StaticResource DayButtonStyle}">
                                <StackPanel>
                                    <TextBlock Text="СБ"
                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="19.07"
                               HorizontalAlignment="Center"
                               FontSize="12"/>
                                </StackPanel>
                            </Button>

                            <!-- НД -->
                            <Button Style="{StaticResource DayButtonStyle}">
                                <StackPanel>
                                    <TextBlock Text="НД"
                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="20.07"
                               HorizontalAlignment="Center"
                               FontSize="12"/>
                                </StackPanel>
                            </Button>

                        </UniformGrid>

                    </Border>

                    <!-- Правая стрелка -->
                    <Button Grid.Column="2"
            Style="{StaticResource ArrowButtonStyle}"
            Content="▶"/>

                </Grid>
                <Border Style="{StaticResource CardStyle}"
        Margin="0,0,0,15">

    <Grid>

        <Grid.ColumnDefinitions>

            <ColumnDefinition/>

            <ColumnDefinition Width="170"/>

        </Grid.ColumnDefinitions>

        <StackPanel>

            <TextBlock
                Text="Stretching"
                Style="{StaticResource CardTitleStyle}"/>

            <TextBlock
                Margin="0,10,0,0"
                Text="18:00 - 19:00"
                Style="{StaticResource CardTextStyle}"/>

            <TextBlock
                Text="Тренер: Анна"
                Style="{StaticResource CardTextStyle}"/>

            <TextBlock
                Text="Велика зала"
                Style="{StaticResource CardTextStyle}"/>

        </StackPanel>

        <Button Grid.Column="1"
                Width="130"
                Height="40"
                Content="Записатися"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"
                Style="{StaticResource PrimaryButtonStyle}"/>

    </Grid>

</Border>
            </StackPanel>

        </ScrollViewer>
    </Grid>
</Page>
