<Page x:Class="TS_2.Views.Pages.SchedulePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TS_2.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SchedulePage">

    <Grid Background="#FFFDFD">
        <ScrollViewer VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="25">
                <!-- Фільтри -->
                <Grid Margin="0,0,0,25">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="DirectionBox"
          Grid.Column="0"
          Style="{StaticResource PinkComboBoxStyle}"
          SelectedIndex="0"
          SelectionChanged="Filter_Changed">

                        <ComboBoxItem>Усі напрямки</ComboBoxItem>
                        <ComboBoxItem>Stretching</ComboBoxItem>
                        <ComboBoxItem>Pilates</ComboBoxItem>
                        <ComboBoxItem>Reformer</ComboBoxItem>

                    </ComboBox>

                    <ComboBox x:Name="TrainerBox"
          Grid.Column="2"
          Style="{StaticResource PinkComboBoxStyle}"
          SelectedIndex="0"
          SelectionChanged="Filter_Changed">

                        <ComboBoxItem>Усі тренери</ComboBoxItem>

                    </ComboBox>

                    <ComboBox x:Name="TimeBox"
          Grid.Column="4"
          Style="{StaticResource PinkComboBoxStyle}"
          SelectedIndex="0"
          SelectionChanged="Filter_Changed">

                        <ComboBoxItem>Увесь день</ComboBoxItem>
                        <ComboBoxItem>Ранок</ComboBoxItem>
                        <ComboBoxItem>День</ComboBoxItem>
                        <ComboBoxItem>Вечір</ComboBoxItem>

                    </ComboBox>

                </Grid>

                <!-- Дні тижня -->

                <Grid Margin="0,0,0,20">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="45"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="45"/>
                    </Grid.ColumnDefinitions>

                    <!-- Левая стрелка -->
                    <Button
                        Grid.Column="0"
                        Style="{StaticResource ArrowButtonStyle}"
                        Content="◀"
                        Click="PreviousWeek_Click"/>

                    <!-- Дни -->
                    <Border Grid.Column="1"
            Background="#FFE5E5"
            CornerRadius="10"
            Padding="1">
                        <Border.Effect>

                            <DropShadowEffect
            BlurRadius="20"
            ShadowDepth="2"
            Opacity="0.22"
            Color="#E8B4B4"/>

                        </Border.Effect>

                        <UniformGrid x:Name="DaysPanel"
             Columns="7"/>
                        

                    </Border>

                    <!-- Правая стрелка -->
                    <Button
    Grid.Column="2"
    Style="{StaticResource ArrowButtonStyle}"
    Content="▶"
    Click="NextWeek_Click"/>

                </Grid>
                <StackPanel x:Name="TrainingsPanel"/>
            </StackPanel>

        </ScrollViewer>
    </Grid>
</Page>
