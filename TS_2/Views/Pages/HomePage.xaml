<Page x:Class="TS_2.Views.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TS_2.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="DashboardPage"
      Background="{StaticResource BackgroundColor}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Grid Margin="30">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>
            <Border Grid.Row="0"
        Background="{StaticResource BannerColor}"
        CornerRadius="22"
        Margin="0,0,0,20">

                <Grid Margin="35">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="250"/>

                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock
                            x:Name="WelcomeTitle"
                Text="Ласкаво просимо до TS Studio!"
                Style="{StaticResource CardTitleStyle}"
                FontSize="28"/>

                        <TextBlock
                            x:Name="WelcomeText"
                Margin="0,10,0,0"
                Text="Почніть шлях до здорового тіла вже сьогодні."
                Style="{StaticResource CardTextStyle}"/>

                        <Button
                            x:Name="WelcomeButton"
                            Width="180"
                            Height="40"
                            Margin="0,20,0,0"
                            HorizontalAlignment="Left"
                            Content="Увійти"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="WelcomeButton_Click"/>

                    </StackPanel>
                    

                </Grid>

            </Border>
            <Grid Grid.Row="1" Margin="0,0,0,20">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="352*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="281*"/>
                    <ColumnDefinition Width="71*"/>
                </Grid.ColumnDefinitions>

                <!-- Левая карточка -->
                <Border Grid.Column="0"
        Style="{StaticResource CardStyle}"
        Margin="10">

                    <StackPanel>

                        <TextBlock
            Text="Найближчі тренування"
            Style="{StaticResource CardTitleStyle}"/>

                        <StackPanel
            x:Name="NearestTrainingsPanel"
            Margin="0,15,0,0"/>

                        <Button
            x:Name="OpenScheduleButton"
            Margin="0,20,0,0"
            Width="170"
            Height="40"
            HorizontalAlignment="Left"
            Style="{StaticResource PrimaryButtonStyle}"
            Content="Переглянути всі"
            Click="OpenScheduleButton_Click"/>

                    </StackPanel>

                </Border>

                <!-- Правая карточка -->
                <Border Grid.Column="2"
            Style="{StaticResource CardStyle}" Grid.ColumnSpan="2" Margin="10,10,10,10">

                    <StackPanel>

                        <TextBlock Text="Події"
               Style="{StaticResource CardTitleStyle}"/>

                        <StackPanel x:Name="NearestEventsPanel"
                Margin="0,15,0,0"/>

                        <Button x:Name="OpenEventsButton"
            Margin="0,20,0,0"
            Width="150"
            Height="38"
            HorizontalAlignment="Left"
            Style="{StaticResource PrimaryButtonStyle}"
            Content="Усі події"
            Click="OpenEventsButton_Click"/>

                    </StackPanel>

                </Border>

            </Grid>
            <Grid Grid.Row="2" Margin="0,0,0,20">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- Акції -->
                <Border Grid.Column="0"
            Style="{StaticResource CardStyle}">

                    <StackPanel>

                        <TextBlock Text="Акції"
                       Style="{StaticResource CardTitleStyle}"/>

                        <TextBlock Margin="0,15,0,0"
                       Text="🎁 -20% на перше тренування"
                       Style="{StaticResource CardTextStyle}"/>

                        <TextBlock Margin="0,8,0,0"
                       Text="💳 Знижка на абонементи до кінця місяця"
                       Style="{StaticResource CardTextStyle}"/>

                    </StackPanel>

                </Border>

                <!-- Новини -->
                <Border Grid.Column="2"
            Style="{StaticResource CardStyle}">

                    <StackPanel>

                        <TextBlock Text="Новини"
                       Style="{StaticResource CardTitleStyle}"/>

                        <TextBlock Margin="0,15,0,0"
                       Text="✨ У студії з'явився новий тренер."
                       Style="{StaticResource CardTextStyle}"/>

                        <TextBlock Margin="0,8,0,0"
                       Text="📢 Відкрито нові групи Pilates."
                       Style="{StaticResource CardTextStyle}"/>

                    </StackPanel>

                </Border>

            </Grid>
            <Border Grid.Row="3"
        Style="{StaticResource CardStyle}">

                <StackPanel>

                    <TextBlock Text="💖 Мотивація дня"
                   Style="{StaticResource CardTitleStyle}"/>

                    <TextBlock Margin="0,15,0,0"
                   FontSize="16"
                   FontStyle="Italic"
                   Text="Маленькі кроки кожного дня приводять до великих результатів."
                   Style="{StaticResource CardTextStyle}"/>

                </StackPanel>

            </Border>

        </Grid>

    </ScrollViewer>
</Page>
