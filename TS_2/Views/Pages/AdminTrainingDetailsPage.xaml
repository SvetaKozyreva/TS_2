<Page x:Class="TS_2.Views.Pages.AdminTrainingDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TS_2.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AdminTrainingDetailsPage">

    <ScrollViewer>

        <StackPanel Margin="30">

            <TextBlock
                x:Name="TrainingNameText"
                FontSize="30"
                FontWeight="Bold"
                Foreground="#6D5555"/>

            <TextBlock
                x:Name="DateText"
                Margin="0,20,0,0"
                Style="{StaticResource CardTextStyle}"/>

            <TextBlock
                x:Name="TimeText"
                Margin="0,5"
                Style="{StaticResource CardTextStyle}"/>

            <TextBlock
                x:Name="TrainerText"
                Margin="0,5"
                Style="{StaticResource CardTextStyle}"/>

            <TextBlock
                x:Name="PlacesText"
                Margin="0,5"
                Style="{StaticResource CardTextStyle}"/>


            <!-- Описание -->

            <Border
                Style="{StaticResource CardStyle}"
                Margin="0,25,0,0">

                <StackPanel>

                    <TextBlock
                        Text="📝 Опис"
                        Style="{StaticResource CardTitleStyle}"/>

                    <TextBlock
                        x:Name="DescriptionText"
                        Margin="0,15,0,0"
                        TextWrapping="Wrap"
                        Style="{StaticResource CardTextStyle}"/>

                </StackPanel>
                

            </Border>
            <StackPanel
    Orientation="Horizontal"
    HorizontalAlignment="Left"
    Margin="0,20,0,0">

                <Button
        Width="180"
        Height="40"
        Margin="0,0,15,0"
        Content="➕ Записати клієнта"
        Style="{StaticResource PrimaryButtonStyle}"
        Click="RegisterClient_Click"/>

            </StackPanel>


            <!-- Клиенты -->

            <Border
                Style="{StaticResource CardStyle}"
                Margin="0,20,0,0">

                <StackPanel>

                    <TextBlock
                        Text="👥 Записані клієнти"
                        Style="{StaticResource CardTitleStyle}"/>

                    <DataGrid
    x:Name="UsersGrid"
    Margin="0,15,0,0"
    AutoGenerateColumns="False"
    CanUserAddRows="False"
    IsReadOnly="True"
    MouseDoubleClick="ParticipantsGrid_MouseLeftButtonUp">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Ім'я"
                            Width="2*"
                            Binding="{Binding FullName}"/>

                            <DataGridTextColumn Header="Телефон"
                            Width="*"
                            Binding="{Binding Phone}"/>

                            <DataGridTextColumn Header="Логін"
                            Width="*"
                            Binding="{Binding Login}"/>

                            <DataGridTemplateColumn Header="Дія" Width="*">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <Button Content="❌ Скасувати"
                            Tag="{Binding}"
                            Style="{StaticResource TableButtonStyle}"
                            Click="CancelRegistration_Click"/>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                        </DataGrid.Columns>

                    </DataGrid>


                </StackPanel>
                

            </Border>

        </StackPanel>
        

    </ScrollViewer>
    
</Page>
