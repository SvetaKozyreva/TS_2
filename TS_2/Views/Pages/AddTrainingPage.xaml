<Page x:Class="TS_2.Views.Pages.AddTrainingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#FFF8F8">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Grid Margin="30">

            <Border Background="White"
                    CornerRadius="20"
                    Padding="35"
                    Style="{StaticResource CardStyle}">

                <StackPanel Width="520"
                            HorizontalAlignment="Center">

                    <!-- Заголовок -->

                    <TextBlock
                        Text="🏋 Додати тренування"
                        Style="{StaticResource PageTitleStyle}"/>

                    <!-- Назва -->

                    <TextBlock
                        Text="📝 Назва тренування"
                        Style="{StaticResource CardTextStyle}"/>

                    <TextBox
                        x:Name="NameBox"/>

                    <!-- Дата -->

                    <TextBlock
                        Text="📅 Дата"
                        Style="{StaticResource CardTextStyle}"/>

                    <DatePicker
                        x:Name="DatePicker"/>

                    <!-- Час -->

                    <TextBlock
                        Text="🕒 Час"
                        Style="{StaticResource CardTextStyle}"/>

                    <TextBox
                        x:Name="TimeBox"/>

                    <!-- Максимальна кількість місць -->

                    <TextBlock
                        Text="👥 Максимальна кількість місць"
                        Style="{StaticResource CardTextStyle}"/>

                    <TextBox
                        x:Name="PlacesBox"/>

                    <!-- Опис -->

                    <TextBlock
                        Text="📖 Опис тренування"
                        Style="{StaticResource CardTextStyle}"/>

                    <TextBox
                        x:Name="DescriptionBox"
                        Height="140"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto"/>

                    <!-- Тренер -->

                    <TextBlock
                        Text="💪 Тренер"
                        Style="{StaticResource CardTextStyle}"/>

                    <ComboBox
                        x:Name="TrainerBox"
                        Width="510"
                        Style="{StaticResource PinkComboBoxStyle}"/>

                    <!-- Кнопки -->

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,20,0,0">

                        <Button
                            x:Name="TitleText"
                            Width="180"
                            Height="45"
                            Margin="0,0,15,0"
                            Content="💾 Зберегти"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="Save_Click"/>

                        <Button
                            Width="180"
                            Height="45"
                            Content="↩ Скасувати"
                            Style="{StaticResource MenuButtonStyle}"
                            Click="Cancel_Click"/>

                    </StackPanel>

                </StackPanel>

            </Border>

        </Grid>

    </ScrollViewer>

</Page>