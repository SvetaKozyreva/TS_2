<Page x:Class="TS_2.Views.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="AdminPage">

    <Grid Background="#FFF8F8">

        <ScrollViewer VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="30">

                <!-- Заголовок -->
                <TextBlock Text="⚙ Панель адміністратора"
                           FontSize="30"
                           FontWeight="SemiBold"
                           Foreground="#6D5555"
                           Margin="0,0,0,30"/>

                <UniformGrid Columns="2">

                    <!-- Користувачі -->
                    <Border Style="{StaticResource CardStyle}"
                            Margin="10"
                            Cursor="Hand"
                            MouseLeftButtonUp="Users_Click">

                        <StackPanel Margin="10">

                            <TextBlock Text="👥"
                                       FontSize="42"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="Користувачі"
                                       Style="{StaticResource CardTitleStyle}"
                                       HorizontalAlignment="Center"
                                       Margin="0,15,0,5"/>

                            <TextBlock Text="Перегляд та керування користувачами"
                                       Style="{StaticResource CardTextStyle}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"/>

                        </StackPanel>

                    </Border>

                    <!-- Тренування -->
                    <Border Style="{StaticResource CardStyle}"
                            Margin="10"
                            Cursor="Hand"
                            MouseLeftButtonUp="Trainings_Click">

                        <StackPanel Margin="10">

                            <TextBlock Text="🏋"
                                       FontSize="42"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="Тренування"
                                       Style="{StaticResource CardTitleStyle}"
                                       HorizontalAlignment="Center"
                                       Margin="0,15,0,5"/>

                            <TextBlock Text="Створення та редагування тренувань"
                                       Style="{StaticResource CardTextStyle}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"/>

                        </StackPanel>

                    </Border>

                    <!-- Події -->
                    <Border Style="{StaticResource CardStyle}"
                            Margin="10"
                            Cursor="Hand"
                            MouseLeftButtonUp="Events_Click">

                        <StackPanel Margin="10">

                            <TextBlock Text="⭐"
                                       FontSize="42"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="Події"
                                       Style="{StaticResource CardTitleStyle}"
                                       HorizontalAlignment="Center"
                                       Margin="0,15,0,5"/>

                            <TextBlock Text="Керування майбутніми подіями студії"
                                       Style="{StaticResource CardTextStyle}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"/>

                        </StackPanel>

                    </Border>

                    <!-- Абонементи -->
                    <Border Style="{StaticResource CardStyle}"
                            Margin="10"
                            Cursor="Hand"
                            MouseLeftButtonUp="Abonements_Click">

                        <StackPanel Margin="10">

                            <TextBlock Text="💳"
                                       FontSize="42"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="Абонементи"
                                       Style="{StaticResource CardTitleStyle}"
                                       HorizontalAlignment="Center"
                                       Margin="0,15,0,5"/>

                            <TextBlock Text="Створення та зміна абонементів"
                                       Style="{StaticResource CardTextStyle}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"/>

                        </StackPanel>

                    </Border>

                </UniformGrid>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Page>