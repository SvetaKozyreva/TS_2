<Page x:Class="TS_2.Views.Pages.AddAbonementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#FFF8F8">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Grid Margin="30">

            <Border
                Style="{StaticResource CardStyle}"
                Padding="35">

                <StackPanel Width="520"
                            HorizontalAlignment="Center">

                    <TextBlock
                        Text="💳 Додати абонемент"
                        Style="{StaticResource PageTitleStyle}"/>

                    <TextBlock
                        Text="📝 Назва"
                        Style="{StaticResource CardTextStyle}"/>

                    <TextBox
                        x:Name="NameBox"
                        Margin="0,8,0,18"/>

                    <TextBlock
                        Text="💰 Вартість"
                        Style="{StaticResource CardTextStyle}"/>

                    <TextBox
                        x:Name="PriceBox"
                        Margin="0,8,0,18"/>

                    <TextBlock
                        Text="🏋 Кількість занять"
                        Style="{StaticResource CardTextStyle}"/>

                    <TextBox
                        x:Name="VisitsBox"
                        Margin="0,8,0,18"/>

                    <TextBlock
                        Text="📅 Тривалість (днів)"
                        Style="{StaticResource CardTextStyle}"/>

                    <TextBox
                        x:Name="DurationBox"
                        Margin="0,8,0,25"/>

                    <TextBlock
                        Text="📖 Опис абонемента"
                        Style="{StaticResource CardTextStyle}"/>

                    <TextBox
                        x:Name="DescriptionBox"
                        Height="80"
                        Margin="0,8,0,25"/>

                    <StackPanel
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">

                        <Button
                            x:Name="SaveButton"
                            Width="180"
                            Height="45"
                            Margin="0,0,15,0"
                            Content="💾 Зберегти"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="Save_Click"/>

                        <Button
                            Width="180"
                            Height="45"
                            Content="↩ Скасувати"
                            Style="{StaticResource MenuButtonStyle}"
                            Click="Cancel_Click"/>

                    </StackPanel>

                </StackPanel>

            </Border>

        </Grid>

    </ScrollViewer>

</Page>