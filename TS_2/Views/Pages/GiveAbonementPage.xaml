<Page x:Class="TS_2.Views.Pages.GiveAbonementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TS_2.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="GiveAbonementPage">

    <Grid Background="#FFF8F8">

        <Border
        Style="{StaticResource CardStyle}"
        Width="500"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Padding="30">

            <StackPanel>

                <TextBlock
                Text="🎫 Видати абонемент"
                FontSize="28"
                FontWeight="Bold"
                Foreground="#6D5555"
                HorizontalAlignment="Center"/>

                <TextBlock
                Margin="0,25,0,5"
                Text="Користувач"
                Style="{StaticResource CardTextStyle}"/>

                <TextBlock
                x:Name="UserNameText"
                FontSize="18"
                FontWeight="SemiBold"
                Foreground="#6D5555"/>

                <TextBlock
                Margin="0,25,0,5"
                Text="Оберіть абонемент"
                Style="{StaticResource CardTextStyle}"/>

                <ComboBox
                x:Name="AbonementBox"
                Height="40"
                FontSize="15"/>

                <TextBlock
                Margin="0,25,0,5"
                Text="Дата початку"
                Style="{StaticResource CardTextStyle}"/>

                <DatePicker
                x:Name="StartDatePicker"
                Height="35"/>

                <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Margin="0,35,0,0">

                    <Button
                    Width="160"
                    Height="42"
                    Margin="0,0,15,0"
                    Content="Видати"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="Give_Click"/>

                    <Button
                    Width="160"
                    Height="42"
                    Content="Скасувати"
                    Style="{StaticResource MenuButtonStyle}"
                    Click="Cancel_Click"/>

                </StackPanel>

            </StackPanel>

        </Border>

    </Grid>
</Page>
