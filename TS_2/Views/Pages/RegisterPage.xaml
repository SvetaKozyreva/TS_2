<Page x:Class="TS_2.Views.Pages.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#FFF8F8">

        <Border Width="460"
                Padding="35"
                Background="White"
                CornerRadius="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>

                <TextBlock Text="Реєстрація"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#C86D6D"
                           HorizontalAlignment="Center"/>

                <TextBlock Margin="0,20,0,5"
                           Text="Ім'я"/>

                <TextBox x:Name="NameBox"
                         Height="38"/>
                <TextBlock
    Text="Роль"
    Margin="0,15,0,5"/>

                <ComboBox
    x:Name="RoleBox"
    Height="40"
    SelectedIndex="0"
    SelectionChanged="RoleBox_SelectionChanged">

                    <ComboBoxItem Content="Клієнт"/>
                    <ComboBoxItem Content="Тренер"/>
                    <ComboBoxItem Content="Адміністратор"/>

                </ComboBox>
                <StackPanel x:Name="SecretPanel"
            Visibility="Collapsed">

                    <TextBlock
        x:Name="SecretText"
        Margin="0,15,0,5"
        Text="Секретний код"/>

                    <PasswordBox
        x:Name="SecretPasswordBox"
        Height="40"/>

                </StackPanel>

                <TextBlock Margin="0,15,0,5"
                           Text="Телефон"/>

                <TextBox x:Name="PhoneBox"
                         Height="38"/>

                <TextBlock Margin="0,15,0,5"
                           Text="Логін"/>

                <TextBox x:Name="LoginBox"
                         Height="38"/>

                <TextBlock Margin="0,15,0,5"
                           Text="Пароль"/>

                <PasswordBox x:Name="PasswordBox"
                             Height="38"/>

                <Button Margin="0,30,0,0"
                        Height="42"
                        Content="Створити акаунт"
                        Style="{StaticResource PrimaryButtonStyle}" Click="CreateAccount_Click"/>

                <Button Margin="0,15,0,0"
                        Content="Назад до входу"
                        Style="{StaticResource MenuButtonStyle}"
                        HorizontalAlignment="Center"
                        Click="Back_Click"/>

            </StackPanel>

        </Border>

    </Grid>

</Page>