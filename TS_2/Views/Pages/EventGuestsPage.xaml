<Page x:Class="TS_2.Views.Pages.EventGuestsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#FFF8F8"
      Title="EventGuestsPage">

    <Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="30">

                <TextBlock x:Name="TitleText"
                           FontSize="30"
                           FontWeight="SemiBold"
                           Foreground="#6D5555"
                           Margin="0,0,0,25"/>

                <TextBlock x:Name="CountText"
                           FontSize="16"
                           Foreground="#8C7070"
                           Margin="0,0,0,20"/>

                <ItemsControl x:Name="GuestsList">

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>

                            <Border Background="White"
                                    CornerRadius="12"
                                    Padding="18"
                                    Margin="0,0,0,12"
                                    BorderBrush="#F0DADA"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="Guest_Click">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>

                                        <TextBlock Text="{Binding FullName}"
                                                   FontSize="19"
                                                   FontWeight="SemiBold"
                                                   Foreground="#6D5555"/>

                                        <TextBlock Text="{Binding Phone}"
                                                   Margin="0,7,0,0"
                                                   Foreground="#777"/>

                                        <TextBlock Text="{Binding Login}"
                                                   Margin="0,4,0,0"
                                                   Foreground="#999"/>

                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               Text="→"
                                               FontSize="24"
                                               Foreground="#C86D6D"
                                               VerticalAlignment="Center"
                                               Margin="20,0,5,0"/>

                                </Grid>

                            </Border>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>

                <TextBlock x:Name="EmptyText"
                           Text="На цю подію ще ніхто не записався."
                           FontSize="16"
                           Foreground="#888"
                           HorizontalAlignment="Center"
                           Margin="0,30,0,0"
                           Visibility="Collapsed"/>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Page>