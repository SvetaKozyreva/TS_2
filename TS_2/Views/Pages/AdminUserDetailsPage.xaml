<Page x:Class="TS_2.Views.Pages.AdminUserDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TS_2.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AdminUserDetailsPage">

    <ScrollViewer>

        <StackPanel Margin="30">

            <TextBlock x:Name="NameText"
                   FontSize="28"
                   FontWeight="Bold"/>

            <TextBlock x:Name="LoginText"
                   Margin="0,15,0,0"/>

            <TextBlock x:Name="PhoneText"
                   Margin="0,8,0,0"/>

            <TextBlock x:Name="RoleText"
                   Margin="0,8,0,25"/>

            <!-- Абонемент -->
            <Border Style="{StaticResource CardStyle}"
                Margin="0,20,0,0">

                <StackPanel>

                    <TextBlock Text="🎫 Активний абонемент"
                           Style="{StaticResource CardTitleStyle}"/>

                    <TextBlock x:Name="AbonementNameText"
                           Style="{StaticResource CardTextStyle}"
                           Margin="0,15,0,5"/>

                    <TextBlock x:Name="RemainingVisitsText"
                           Style="{StaticResource CardTextStyle}"
                           Margin="0,5"/>

                    <TextBlock x:Name="EndDateText"
                           Style="{StaticResource CardTextStyle}"
                           Margin="0,5"/>

                    <Button x:Name="GiveAbonementButton"
                        Margin="0,20,0,0"
                        Width="180"
                        Height="40"
                        HorizontalAlignment="Left"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Content="Видати абонемент"
                        Click="GiveAbonementButton_Click"/>

                </StackPanel>

            </Border>

            <!-- Записи -->
            <Border Style="{StaticResource CardStyle}"
                Margin="0,20,0,0">

                <StackPanel>

                    <TextBlock Text="🏋 Записи на тренування"
                           Style="{StaticResource CardTitleStyle}"/>

                    <StackPanel x:Name="TrainingPanel"
                            Margin="0,15,0,0"/>

                </StackPanel>

            </Border>

        </StackPanel>

    </ScrollViewer>
</Page>
