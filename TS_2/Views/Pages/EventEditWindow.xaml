<Page x:Class="TS_2.Views.Pages.EventEditWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#FFF8F8">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Grid Margin="30">

            <Border Background="White"
                    CornerRadius="20"
                    Padding="35"
                    Style="{StaticResource CardStyle}">

                <StackPanel Width="520"
                            HorizontalAlignment="Center">

                    <!-- Заголовок -->

                    <TextBlock
                        x:Name="PageTitle"
                        Text="⭐ Додати подію"
                        Style="{StaticResource PageTitleStyle}"/>

                    <!-- Назва -->

                    <TextBlock
                        Text="📝 Назва події"
                        Style="{StaticResource CardTextStyle}"
                        Margin="0,10,0,6"/>

                    <TextBox
                        x:Name="TitleBox"/>

                    <!-- Дата -->

                    <TextBlock
                        Text="📅 Дата"
                        Style="{StaticResource CardTextStyle}"
                        Margin="0,10,0,6"/>

                    <DatePicker
                        x:Name="DatePicker"/>

                    <!-- Місце -->

                    <TextBlock
                        Text="📍 Місце проведення"
                        Style="{StaticResource CardTextStyle}"
                        Margin="0,10,0,6"/>

                    <TextBox
                        x:Name="PlaceBox"/>

                    <!-- Максимальна кількість -->

                    <TextBlock
                        Text="👥 Максимальна кількість учасників"
                        Style="{StaticResource CardTextStyle}"
                        Margin="0,10,0,6"/>

                    <TextBox
                        x:Name="MaxParticipantsBox"/>

                    <!-- Ціна -->

                    <TextBlock
                        Text="💰 Вартість"
                        Style="{StaticResource CardTextStyle}"
                        Margin="0,10,0,6"/>

                    <TextBox
                        x:Name="PriceBox"/>

                    <!-- Опис -->

                    <TextBlock
                        Text="📖 Опис події"
                        Style="{StaticResource CardTextStyle}"
                        Margin="0,10,0,6"/>

                    <TextBox
                        x:Name="DescriptionBox"
                        Height="140"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto"/>

                    <!-- Кнопки -->

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,20,0,0">

                        <Button
                            Width="180"
                            Height="45"
                            Margin="0,0,15,0"
                            Content="💾 Зберегти"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="Save_Click"/>

                        <Button
                            Width="180"
                            Height="45"
                            Content="↩ Скасувати"
                            Style="{StaticResource MenuButtonStyle}"
                            Click="Cancel_Click"/>

                    </StackPanel>

                </StackPanel>

            </Border>

        </Grid>

    </ScrollViewer>

</Page>