<Window x:Class="TS_2.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TS_2.Views"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Grid Background="#FFF8F8">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Ліва панель -->
        <Border Background="#FCE5E5">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="120"/>
                    <RowDefinition Height="220"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="170"/>
                </Grid.RowDefinitions>

                <!-- Логотип -->
                <StackPanel Grid.Row="0"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">

                    <TextBlock Text="TS"
                           FontSize="38"
                           Foreground="#C86D6D"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>

                    <TextBlock Text="TRUSHKINA STRETCHING"
                           FontSize="14"
                           Foreground="#9B6B6B"
                           HorizontalAlignment="Center"/>

                </StackPanel>

                <!-- Меню -->
                <StackPanel Grid.Row="1">

                    <Button x:Name="HomeButton"
                            Style="{StaticResource PrimaryButtonStyle}"
                        Content="🏠  Головна"
                        Height="45"
                        Margin="15,5"
                        Click="HomeButton_Click"/>

                    <Button x:Name="ScheduleButton"
                            Style="{StaticResource MenuButtonStyle}"
                            HorizontalContentAlignment="Left"
                        Padding="18,0,0,0"
                        Content="📅  Розклад"
                        Height="45"
                        Margin="15,5"
                        Click="ScheduleButton_Click"/>

                    <Button x:Name="EventsButton"
                            Style="{StaticResource MenuButtonStyle}"
                        Content="⭐  Події"
                        Height="45"
                        Margin="15,5"
                        Click="EventsButton_Click"/>

                    <Button x:Name="AbonementsButton"
                            Style="{StaticResource MenuButtonStyle}"
                        Content="💳  Абонементи"
                        Height="45"
                        Margin="15,5"
                        Click="AbonementsButton_Click"/>
                    <Button x:Name="AdminButton"
        Style="{StaticResource MenuButtonStyle}"
        Content="⚙ Адмін-панель"
        Height="45"
        Margin="15,5"
        Visibility="Collapsed"
        Click="AdminButton_Click"/>

                </StackPanel>

                <!-- Мотивація -->
                <Border Grid.Row="3"
                    Margin="15"
                    CornerRadius="15"
                    Background="White">

                    <StackPanel Margin="10">

                        <TextBlock Text="💖 Мотивація дня"
                               FontWeight="Bold"
                               FontSize="16"/>

                        <TextBlock Margin="0,10,0,0"
                               TextWrapping="Wrap"
                               FontSize="13"
                               Text="Кожне тренування робить тебе сильнішою."/>

                    </StackPanel>

                </Border>

            </Grid>

        </Border>

        <!-- Правая часть -->
        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Верхня панель -->
            <Border Grid.Row="0"
        Background="White"
        Margin="15,15,15,10"
        CornerRadius="15">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Заголовок -->
                    <TextBlock
                        x:Name="PageTitle"
            Text="Головна"
            FontSize="20"
            FontWeight="SemiBold"
            Foreground="#6D5555"
            VerticalAlignment="Center"
            Margin="25,0"/>

                    <!-- Кнопка входу -->
                    <Button Grid.Column="1"
                            
                x:Name="LoginButton"
                Style="{StaticResource LoginButtonStyle}"
                Content="👤 Вхід"
                Margin="0,0,20,0" Click="LoginButton_Click"/>
                    
                </Grid>

            </Border>

            <!-- Відкриття сторінок -->
            <Frame x:Name="MainFrame"
               Grid.Row="1"
               NavigationUIVisibility="Hidden"/>

        </Grid>

    </Grid>
</Window>
